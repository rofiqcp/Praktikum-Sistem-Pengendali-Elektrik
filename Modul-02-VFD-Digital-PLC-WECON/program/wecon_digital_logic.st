(* IEC 61131-3 Structured Text reference. Sesuaikan alamat I/O PLC WECON aktual. *)
VAR
  START, STOP_NC, FWD_SEL, REV_SEL, FAULT_OK : BOOL;
  SPEED1, SPEED2 : BOOL;
  RUN_LATCH : BOOL;
  DO_FWD, DO_REV, DO_MS1, DO_MS2 : BOOL;
END_VAR

IF NOT STOP_NC OR NOT FAULT_OK THEN
  RUN_LATCH := FALSE;
ELSIF START THEN
  RUN_LATCH := TRUE;
END_IF;

(* XOR interlock: hanya satu arah boleh aktif *)
DO_FWD := RUN_LATCH AND FWD_SEL AND NOT REV_SEL;
DO_REV := RUN_LATCH AND REV_SEL AND NOT FWD_SEL;
DO_MS1 := SPEED1;
DO_MS2 := SPEED2;
